# Local SQLite database. Production must set an explicit persistent location.
DATABASE_URL=file:./data/local.db

# Required by POST /api/inbound for local extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_MS=15000

# Read-only local CRM. Use a random value of at least 16 characters.
CRM_ENABLED=true
CRM_ACCESS_TOKEN=

# Manager handoff notifications. Credentials are required only when enabled.
TELEGRAM_MANAGER_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Also use this value as setWebhook secret_token for /api/telegram/webhook.
TELEGRAM_MANAGER_INVITE_CODE=

# Required only after the Avito provider is connected.
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
