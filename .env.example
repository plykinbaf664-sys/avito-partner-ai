# Local SQLite database. Production must set an explicit persistent location.
DATABASE_URL=file:./data/local.db

# Required by POST /api/inbound for local extraction.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_TIMEOUT_MS=15000

# Read-only local CRM. Use a random value of at least 16 characters.
CRM_ENABLED=true
CRM_ACCESS_TOKEN=

# Manager handoff notifications. Credentials are required only when enabled.
TELEGRAM_MANAGER_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_INVITE_CODE=
# Independent secret_token supplied to Telegram setWebhook (16-128 safe characters).
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS URL ending in /api/telegram/webhook, only for setWebhook.
TELEGRAM_WEBHOOK_URL=

# Avito channel. Keep disabled until the real account is ready for bot replies.
AVITO_CHANNEL_ENABLED=false
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
# Public HTTPS URL ending in /api/avito/webhook, only for webhook registration.
AVITO_WEBHOOK_URL=
