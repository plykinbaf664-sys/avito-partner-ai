[Unit]
Description=Avito webhook recovery and follow-up worker
After=network.target avito-partner-ai.service

[Service]
Type=simple
WorkingDirectory=/opt/avito-partner-ai
ExecStart=/usr/bin/npm run worker:avito -- --interval-ms 60000
Restart=always
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
